<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{preview.title}}</title>
  <meta name="description" content="{{preview.description}}" />
  <meta name="robots" content="noindex,nofollow" />
  <link rel="canonical" href="{{shortUrl}}" />

  <meta property="og:type" content="{{#if preview.video_secure_url}}video.other{{else}}website{{/if}}" />
  <meta property="og:site_name" content="{{site_name}}" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content="{{preview.title}}" />
  <meta property="og:description" content="{{preview.description}}" />
  <meta property="og:url" content="{{shortUrl}}" />

  <meta property="og:image" content="{{preview.image_secure_url}}" />
  <meta property="og:image:secure_url" content="{{preview.image_secure_url}}" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="{{preview.image_width}}" />
  <meta property="og:image:height" content="{{preview.image_height}}" />
  <meta property="og:image:alt" content="{{preview.image_alt}}" />

  {{#if preview.video_secure_url}}
    <meta property="og:video" content="{{preview.video_secure_url}}" />
    <meta property="og:video:url" content="{{preview.video_secure_url}}" />
    <meta property="og:video:secure_url" content="{{preview.video_secure_url}}" />
    <meta property="og:video:type" content="{{preview.video_mime_type}}" />
    {{#if preview.video_width}}<meta property="og:video:width" content="{{preview.video_width}}" />{{/if}}
    {{#if preview.video_height}}<meta property="og:video:height" content="{{preview.video_height}}" />{{/if}}
  {{/if}}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{preview.title}}" />
  <meta name="twitter:description" content="{{preview.description}}" />
  <meta name="twitter:image" content="{{preview.image_secure_url}}" />
  <meta name="twitter:image:alt" content="{{preview.image_alt}}" />
</head>
<body>
  <main>
    <h1>{{preview.title}}</h1>
    <p>{{preview.description}}</p>
    <img src="{{preview.image_secure_url}}" alt="{{preview.image_alt}}" width="{{preview.image_width}}" height="{{preview.image_height}}" />
  </main>
</body>
</html>
